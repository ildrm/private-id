# Local development; never reuse these secrets outside a disposable environment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
SITE_URL=http://localhost:3001
DATABASE_URL=postgres://privateid:privateid_dev@localhost:5432/privateid_db
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
PRIVATEID_ISSUER=http://localhost:3001
# Keep stable across local restarts. Generate distinct random secrets for deployment.
PRIVATEID_PROOF_SECRET=local-proof-secret-000000000000000000000001
PRIVATEID_SUBJECT_SECRET=local-subject-secret-0000000000000000000001
DATA_ENCRYPTION_KEY=ERERERERERERERERERERERERERERERERERERERERERE=
ALLOWED_ORIGINS=http://localhost:3101,http://127.0.0.1:3101
TRUSTED_PROXIES=
LOG_LEVEL=info
MAIL_DIRECTORY=.data/mail
MAIL_FROM=PrivateID <noreply@localhost>
# SMTP_URL=smtps://username:password@smtp.example.com:465
SESSION_HOURS=1
PROOF_SECONDS=300
CONSENT_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=365
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PROFESSIONAL=price_...
# STRIPE_PRICE_BUSINESS=price_...
# Production also requires TLS PostgreSQL, SMTP, and mounted Ed25519 files:
# PRIVATEID_SIGNING_KEY_FILE=/run/secrets/signing-private.pem
# PRIVATEID_SIGNING_KEY_ID=signing-2026-09
# PRIVATEID_PUBLIC_KEYS_FILE=/run/secrets/public-key-ring.json
